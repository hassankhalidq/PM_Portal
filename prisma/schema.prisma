generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  INTERNAL
  // "EXTERNAL" / "CLIENT" can be added later without a schema rewrite
}

enum NodeStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MilestoneType {
  RELEASE
  LAUNCH
  DEADLINE
  CHECKPOINT
  DEPRECATION
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(INTERNAL)
  comments     Comment[]
  createdAt    DateTime  @default(now())
}

model Board {
  id        String        @id @default(cuid())
  name      String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  nodes     ProjectNode[]
}

// ---------- Board 1: Project Board (recursive tree) ----------
model ProjectNode {
  id          String        @id @default(cuid())
  name        String
  owner       String        @default("")
  status      NodeStatus    @default(NOT_STARTED)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  link        String        @default("")
  startDate   DateTime?
  endDate     DateTime?
  description String        @default("")
  parentId    String?
  parent      ProjectNode?  @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectNode[] @relation("Tree")
  comments    Comment[]
  attachments Attachment[]
  sortOrder   Int           @default(0)
  board       Board?        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([parentId])
  @@index([boardId])
}

model Attachment {
  id        String      @id @default(cuid())
  name      String
  url       String
  size      Int
  node      ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    String
  createdAt DateTime    @default(now())

  @@index([nodeId])
}

model Comment {
  id        String      @id @default(cuid())
  body      String
  node      ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime    @default(now())

  @@index([nodeId])
}

model Roadmap {
  id         String        @id @default(cuid())
  name       String
  theme      String        @default("indigo")
  isDefault  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  categories Category[]
  milestones Milestone[]
}

// ---------- Board 2: Roadmap Board ----------
model Category {
  id         String        @id @default(cuid())
  name       String
  color      String        @default("#0E7A5F")
  sortOrder  Int           @default(0)
  items      RoadmapItem[]
  roadmap    Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId  String?

  @@index([roadmapId])
}

model RoadmapItem {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  startDate   DateTime
  endDate     DateTime
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Milestone {
  id          String        @id @default(cuid())
  name        String
  type        MilestoneType @default(RELEASE)
  date        DateTime
  description String        @default("")
  createdAt   DateTime      @default(now())
  roadmap     Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId   String?

  @@index([roadmapId])
}
