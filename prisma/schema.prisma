generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INTERNAL
  // "EXTERNAL" / "CLIENT" can be added later without a schema rewrite
}

// Per-section access for INTERNAL/ADMIN users. NONE hides the section
// entirely (nav item and route); VIEW renders it read-only; EDIT is full
// read/write. SUPER_ADMIN ignores this and always has full access
// everywhere, across every org.
enum AccessLevel {
  NONE
  VIEW
  EDIT
}

enum NodeStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MilestoneType {
  RELEASE
  LAUNCH
  DEADLINE
  CHECKPOINT
  DEPRECATION
}

enum RoadmapStage {
  EXPLORING
  PLANNED
  COMMITTED
}

// A tenant. Every user, board, and roadmap belongs to exactly one
// Organization; that's the entire isolation boundary between companies
// sharing this deployment. SUPER_ADMIN accounts still have a home org (kept
// non-nullable for simplicity) but their role bypasses the boundary.
model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  users     User[]
  boards    Board[]
  roadmaps  Roadmap[]
}

model User {
  id             String       @id @default(cuid())
  email          String
  name           String
  passwordHash   String
  role           Role         @default(INTERNAL)
  // Section-level access, independent of role. Ignored for SUPER_ADMIN.
  projectAccess  AccessLevel  @default(EDIT)
  roadmapAccess  AccessLevel  @default(EDIT)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String?
  comments       Comment[]
  createdAt      DateTime     @default(now())

  // Email is unique per org, not globally — the same person's email can
  // exist as separate accounts in separate companies. Login resolves the
  // org first (from the login link/picker), then looks up by [orgId, email].
  @@unique([orgId, email])
  @@index([orgId])
}

model Board {
  id             String         @id @default(cuid())
  name           String
  description    String         @default("")
  isDefault      Boolean        @default(false)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String?
  createdAt      DateTime       @default(now())
  nodes          ProjectNode[]
  weeklyStatuses WeeklyStatus[]

  @@index([orgId])
}

// ---------- Board 1: Project Board (recursive tree) ----------
model ProjectNode {
  id          String        @id @default(cuid())
  name        String
  owner       String        @default("")
  status      NodeStatus    @default(NOT_STARTED)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  link        String        @default("")
  startDate   DateTime?
  endDate     DateTime?
  description String        @default("")
  blockReason String        @default("")
  request     String        @default("")
  parentId    String?
  parent      ProjectNode?  @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectNode[] @relation("Tree")
  comments    Comment[]
  attachments Attachment[]
  logEntries  LogEntry[]
  dependsOn   ItemDependency[] @relation("DependencySuccessor")
  blocks      ItemDependency[] @relation("DependencyPredecessor")
  sortOrder   Int           @default(0)
  board       Board?        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([parentId])
  @@index([boardId])
}

// A running, spreadsheet-style daily update log, mapped to either a whole
// project or one of its sub-items. Distinct from Comment (informal,
// single-node, no board-wide browsing view).
model LogEntry {
  id        String      @id @default(cuid())
  date      DateTime
  activity  String
  owner     String      @default("")
  waitingOn String      @default("")
  status    String      @default("")
  remarks   String      @default("")
  node      ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([nodeId])
}

// A whole-project, per-week snapshot card (issues, blockers, freeform
// summary). Scoped directly to Board (unlike LogEntry, which is scoped to
// ProjectNode) because nothing here is about a single item — it's a
// board-wide rollup. blockerTeams/blockerDetails are Json arrays because
// the UI edits the whole card (including adding/removing team tiles and
// detail rows) as one atomic Save, never as independent row CRUD.
model WeeklyStatus {
  id             String   @id @default(cuid())
  board          Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId        String
  weekStart      DateTime
  weekEnd        DateTime
  label          String   @default("")
  summary        String   @default("")
  issuesFound    Int      @default(0)
  issuesResolved Int      @default(0)
  blockerTeams   Json     @default("[]")
  blockerDetails Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([boardId])
  @@index([boardId, weekStart])
}

// Real item-to-item dependency (predecessor must finish before successor
// starts), rendered as arrows on the Project Timeline. Deliberately not
// named "dependency" on either side of the relation, to stay visually and
// verbally distinct from LogEntry.waitingOn.
model ItemDependency {
  id            String      @id @default(cuid())
  predecessor   ProjectNode @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  predecessorId String
  successor     ProjectNode @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  successorId   String
  createdAt     DateTime    @default(now())

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model Attachment {
  id        String      @id @default(cuid())
  name      String
  url       String
  size      Int
  node      ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    String
  createdAt DateTime    @default(now())

  @@index([nodeId])
}

model Comment {
  id        String      @id @default(cuid())
  body      String
  node      ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime    @default(now())

  @@index([nodeId])
}

model Roadmap {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  theme       String        @default("indigo")
  isDefault   Boolean       @default(false)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String?
  createdAt   DateTime      @default(now())
  categories  Category[]
  milestones  Milestone[]

  @@index([orgId])
}

// ---------- Board 2: Roadmap Board ----------
model Category {
  id         String        @id @default(cuid())
  name       String
  color      String        @default("#0E7A5F")
  sortOrder  Int           @default(0)
  items      RoadmapItem[]
  milestones Milestone[]
  roadmap    Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId  String?

  @@index([roadmapId])
}

model RoadmapItem {
  id          String       @id @default(cuid())
  name        String
  description String       @default("")
  startDate   DateTime
  endDate     DateTime
  stage       RoadmapStage @default(PLANNED)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}

model Milestone {
  id          String        @id @default(cuid())
  name        String
  type        MilestoneType @default(RELEASE)
  date        DateTime
  description String        @default("")
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  roadmap     Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapId   String?
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  @@index([roadmapId])
  @@index([categoryId])
}
